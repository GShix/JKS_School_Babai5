# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example from Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
db_string=

# JWT Configuration
# Secret key for signing JWT tokens (use a strong random string, at least 32 characters)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production
# Token expiration time (optional, defaults: 7d for admin/teacher, 30d for students)
JWT_EXPIRES_IN=7d

# Supabase Configuration (for file storage)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# or use service role key for admin operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration (optional)
NODE_ENV=development
PORT=4000
